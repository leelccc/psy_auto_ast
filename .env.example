POSTGRES_DB=psy_auto_ast
POSTGRES_USER=psy_auto_ast
POSTGRES_PASSWORD=psy_auto_ast_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://psy_auto_ast:psy_auto_ast_dev@127.0.0.1:55432/psy_auto_ast
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
PROFILE_ACCESS_GRANT_MINUTES=60

MINIO_ROOT_USER=psy_auto_ast
MINIO_ROOT_PASSWORD=psy_auto_ast_minio_dev
MINIO_HOST=127.0.0.1
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
MINIO_ENDPOINT=127.0.0.1:59000
MINIO_BUCKET=psy-auto-ast
MINIO_SECURE=false

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Recording transcription and summary generation
RECORDING_AI_PROVIDER=bailian
# base64 for local private MinIO; switch to minio_url after MinIO is public-reachable
RECORDING_AUDIO_INPUT_MODE=base64
BAILIAN_API_KEY=replace-with-your-bailian-api-key
BAILIAN_ASR_MODEL=fun-asr
BAILIAN_LOCAL_ASR_MODEL=qwen3-asr-flash
BAILIAN_SUMMARY_MODEL=qwen-plus
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
BAILIAN_TIMEOUT_SECONDS=120
BAILIAN_POLL_INTERVAL_SECONDS=1
BAILIAN_MAX_POLL_ATTEMPTS=120

# CORS 白名单（仅 Web 端受影响，逗号分隔）；原生 App 不走 CORS
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# 微信登录（在 https://open.weixin.qq.com 注册应用后填写）
# Web 扫码登录用「网站应用」的 AppID/Secret；原生用「移动应用」的（两者独立）
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
# 微信回调到后端的地址，需在开放平台「授权回调域」登记
WECHAT_WEB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/wechat/web/callback
# 后端处理完跳回前端（Web 端）
WECHAT_FRONTEND_REDIRECT_URI=http://localhost:19000
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=

# --- 邮箱验证码 / SMTP（用于邮箱验证码注册与重置密码）---
# 未配置 smtp_host 时：开发环境会在响应中回传 dev_code 便于本地联调，生产环境直接报错。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=True

# --- 手机验证码 / 阿里云短信（用于手机号验证码登录、注册与重置密码）---
# 未配置 SMS_ACCESS_KEY_ID 等时：开发环境回传 dev_code，生产环境报错。
# 需要先在阿里云申请短信签名与三个模板（注册/登录/重置密码），模板变量名为 code。
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_REGISTER=
SMS_TEMPLATE_LOGIN=
SMS_TEMPLATE_RESET_PASSWORD=
SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 验证码通用策略（邮箱/手机号共用）
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_MINUTES=10
VERIFICATION_CODE_RETRY_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
